{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start OLV Server",
            "program": "${workspaceFolder}/app.js",
            "cwd": "${workspaceFolder}",
            "env": { "PORT": "3001" },
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Launch Microsoft Edge against localhost",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Opera against localhost",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "${env:LOCALAPPDATA}/Programs/Opera/opera.exe"
        }
    ],
    "compounds": [
        {
            "name": "Launch OLV System",
            "configurations": ["Start OLV Server", "Launch Microsoft Edge against localhost"],
            "stopAll": true
        },
        {
            "name": "Launch OLV System in Opera",
            "configurations": ["Start OLV Server", "Launch Opera against localhost"],
            "stopAll": true
        }
    ]
}
