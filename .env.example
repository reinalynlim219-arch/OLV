# Gmail settings (never commit real values).
# Used to email account confirmation links, password reset links, and reports.
GMAIL_USER=your-reporting-account@gmail.com
GMAIL_APP_PASSWORD=16-character-app-password
REPORT_RECIPIENT=recipient@example.com

# Address customers use to open the system. Links in emails point here.
# Use the computer's network address (e.g. http://192.168.1.10:3000) so links open on phones.
APP_URL=http://localhost:3000

# Your own website address for npm run online (e.g. https://olvwater.com), through a
# free Cloudflare tunnel. See docs/own-domain-setup.md. Use this OR ngrok below, not both.
CLOUDFLARE_TUNNEL_TOKEN=
SITE_URL=

# One-time secret for sending this laptop's data to a new cloud server
# (npm run cloud:upload). See docs/cloud-hosting.md.
OLV_IMPORT_TOKEN=

# Permanent online address for npm run online (free account at https://ngrok.com).
# Leave both empty for a free address that changes every start.
NGROK_AUTHTOKEN=
NGROK_URL=

# Road distances for the delivery plan (free OSRM server, OpenStreetMap roads).
# Only map coordinates are sent. Leave out to use the default; set empty for straight lines.
# ROUTING_URL=https://router.project-osrm.org
